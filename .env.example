# DEFAULT: complete local demo, no API keys. Do not use real customer data in demo/test.
RIGRX_MODE=demo
SMS_MODE=simulated
PAYMENT_MODE=simulated
STORAGE_MODE=local
PORT=3000
BASE_URL=http://localhost:3000
# Set BASE_URL to your exact HTTPS app URL when hosted.
# For Replit/reverse proxy, set TRUST_PROXY=1 after confirming one trusted proxy hop.
TRUST_PROXY=

# Optional in demo; REQUIRED in live. If blank, the embedded demo DB is used.
DATABASE_URL=
# Default validates remote TLS. disable only for local PostgreSQL;
# insecure only when your database provider explicitly requires it.
DB_SSL=
# Local demo database folder (one app process only):
DEMO_DATABASE_DIR=
# Live administrator's phone in E.164 format, e.g. +1661... (not a secret).
ADMIN_PHONE=
# Live required, random 32+ characters; never share or commit this value.
OTP_SECRET=

# SMS_MODE=twilio requires all three. Otherwise codes are shown on screen in demo/test.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# PAYMENT_MODE=stripe requires all three.
# Use Stripe TEST keys first. Webhook endpoint: /api/payments/webhook
# Subscribe to payment_intent.succeeded.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# STORAGE_MODE=s3 for private S3 or Cloudflare R2 storage:
S3_BUCKET=
S3_REGION=auto
# R2: https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com ; AWS S3: leave blank
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Alternative: local uploads on a persistent volume. Required for live local storage.
UPLOAD_DIR=
# Only explicitly enable on an empty non-production PostgreSQL test database.
SEED_DEMO=false
